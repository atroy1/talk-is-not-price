# Figure style for the Apart report. Load with plt.style.use("report/figstyle.mplstyle").
# Sizes assume the figure is placed at its true width in the Doc: 6.5 in full, 3.15 in half. Minimum type 8 pt.
font.family: sans-serif
font.sans-serif: Helvetica Neue, Helvetica, Arial, DejaVu Sans
font.size: 8.5
axes.titlesize: 9
axes.titleweight: bold
axes.titlelocation: left
axes.labelsize: 8.5
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 8
legend.frameon: False
legend.handlelength: 1.6
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.6
axes.edgecolor: 444444
axes.labelcolor: 222222
xtick.color: 444444
ytick.color: 444444
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.major.size: 3
ytick.major.size: 3
axes.grid: True
axes.grid.axis: y
grid.color: dddddd
grid.linewidth: 0.4
axes.axisbelow: True
lines.linewidth: 1.5
lines.markersize: 4
# fixed categorical order; validated with the dataviz palette checker 2026-10-18 (all pass; 4 and 5 direct-labelled)
axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', 'E69F00', 'CC79A7'])
figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.02
savefig.facecolor: white
